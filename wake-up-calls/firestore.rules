rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cloud Functions use the Admin SDK and always bypass these rules.
    // Everything below only governs direct access from the admin
    // dashboard, so it's gated on being signed in as the college admin.
    //
    // Single admin per college for now: any authenticated user is
    // trusted. If more than one admin account is ever created, tighten
    // this to a custom claim or an explicit allow-list.
    function isAdmin() {
      return request.auth != null;
    }

    match /students/{studentId} {
      allow read, write: if isAdmin();
    }

    match /callEvents/{eventId} {
      allow read, write: if isAdmin();
      // NOTE: the countdown page (not built yet) will need to read one
      // callEvent by its token without being signed in. Do not open a
      // blanket unauthenticated read here when that's built - route it
      // through a callable function that only returns the token-matched
      // countdown fields, so the whole collection isn't scannable.
    }

    match /settings/{settingsId} {
      allow read, write: if isAdmin();
    }
  }
}
